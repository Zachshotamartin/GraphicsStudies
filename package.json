{
  "name": "@zachshotamartin/graphics-studies",
  "version": "1.0.0",
  "private": false,
  "type": "module",
  "description": "Interactive image quilting and texture transfer studies after Efros and Freeman (2001).",
  "license": "MIT",
  "exports": {
    ".": "./src/quilting.js",
    "./worker": "./src/worker.js",
    "./lab": "./src/lab.js",
    "./lab.css": "./src/lab.css",
    "./experiments": "./src/experiments/lab.js",
    "./experiments-worker": "./src/experiments/worker.js",
    "./experiments.css": "./src/experiments/lab.css",
    "./catalog": "./src/experiments/catalog.js",
    "./algorithms/*": "./src/algorithms/*.js"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test tests/*.test.js",
    "start": "node web/serve.mjs",
    "test:browser": "node tests/browser-studies.mjs",
    "examples": "node scripts/generate-examples.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1"
  }
}
